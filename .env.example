# ---- Session (app cookie login) ----
# Random long string used to sign the session JWT. Generate: openssl rand -hex 32
SESSION_SECRET=sIDJ67rZmj2GL+Gz3Q1HCRBnqPoBUcG/OX3BFQBi9XUl1zXOhvuVmPklep7bu7GkyXp1uBDu+hviDqdejny+gQ==

# ---- Firebase Admin SDK (service account) ----
# Paste the ENTIRE service-account JSON on one line (stringified).
# Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ---- OpenAI (real upstream keys the gateway uses) ----
# Multiple keys for automatic fallback: if one hits a rate limit (429),
# is invalid (401), or the upstream errors (5xx), the gateway retries the
# next key in the list. Comma-separated, tried left-to-right.
OPENAI_API_KEYS=sk-your-real-openai-key,sk-your-backup-openai-key
# Backwards-compatible single-key alias. If OPENAI_API_KEYS is set it wins;
# otherwise this one is used.
OPENAI_API_KEY=sk-your-real-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Seed admin (used once by `npm run seed:admin`) ----
SEED_ADMIN_EMAIL=techloot1100@gmail.com
SEED_ADMIN_PASSWORD=adminhub
